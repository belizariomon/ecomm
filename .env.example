# Real OAuth through Auth0 is the default. Set this to mock only for an isolated local demo.
VITE_AUTH_MODE=auth0

# Required only when VITE_AUTH_MODE=auth0. These are public browser values, not secrets.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-single-page-app-client-id

# Never place Auth0 connection secrets or backend credentials in a VITE_ variable.
